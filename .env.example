# Required (set these in Railway -> your service -> Variables)
DISCORD_TOKEN=paste-your-bot-token-here

# Optional on Railway: BASE_URL is auto-detected from RAILWAY_PUBLIC_DOMAIN.
# Only set it if you use a custom domain (no trailing slash).
BASE_URL=

# Optional
GUILD_ID=                  # your server ID: slash commands appear instantly
ADMIN_IDS=                 # comma-separated Discord user IDs allowed to use admin commands
BUYER_ROLE_ID=             # role given when someone redeems a key
KEY_PREFIX=MYHUB           # keys look like MYHUB-XXXX-XXXX-XXXX-XXXX
BRAND=MyHub
HWID_RESET_COOLDOWN_HOURS=24
RATE_LIMIT_PER_MIN=40
# DB_PATH is auto-set to your Railway Volume (RAILWAY_VOLUME_MOUNT_PATH/keybot.db). Leave blank.
DB_PATH=
